# --- Required ---------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Railway, local...)
DATABASE_URL=postgres://localhost:5432/postdesk

# The URL this app is served from, no trailing slash. Used for LinkedIn OAuth redirects.
APP_URL=http://localhost:3000

# Password for the single admin login.
ADMIN_PASSWORD=change-me

# 32+ random bytes, base64. Signs the login cookie and encrypts LinkedIn tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Workspace name shown in the app (the company you post for).
WORKSPACE_NAME=Acme Coffee Roasters
TIMEZONE=America/New_York

# --- LinkedIn ---------------------------------------------------------------
# From https://www.linkedin.com/developers/apps  (see README "LinkedIn setup")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Marketing API version, YYYYMM. Keep this current: LinkedIn sunsets versions after ~1 year.
LINKEDIN_VERSION=202609
# Scopes. The org set needs the Community Management API product (approval required).
LINKEDIN_MEMBER_SCOPES=openid profile w_member_social
LINKEDIN_ORG_SCOPES=openid profile w_member_social w_organization_social r_organization_social r_organization_social_feed rw_organization_admin

# --- Drafting (optional) ----------------------------------------------------
ANTHROPIC_API_KEY=
# Any current Claude model id from https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Read-only token (fine-grained PAT: Contents + Pull requests: read) for "what we shipped" drafts.
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo
